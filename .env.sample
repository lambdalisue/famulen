# Copy to .env, fill it in, and keep it to yourself (chmod 600 .env).
# Docker Compose passes it to the backend; `famulen` run by hand reads .env
# from the directory it is started in. Variables already set win over it.

# Where you open the console, for logins to come back to
# (<this>/oauth/callback). Slack wants https, e.g. a Tailscale Serve URL.
FAMULEN_CONSOLE_URL=http://127.0.0.1:3000

# Claude Code's login inside the container: run `claude setup-token` on a
# machine where you are logged in and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

# The key the vault seals secrets with, as age-keygen makes one. Without it,
# logins and keys cannot be kept; the backend's log then shows a new key to
# use. Keep a copy: secrets cannot be opened without it.
FAMULEN_VAULT_KEY=

# Famulen's GitHub OAuth app, registered once (crates/gateway/services/github/README.md). Every GitHub
# account you add on the console uses it.
# FAMULEN_GITHUB_CLIENT_ID=
# FAMULEN_GITHUB_CLIENT_SECRET=

# Famulen's Google app, registered once (crates/gateway/services/google/README.md). Every Google
# account you add on the console uses it.
# FAMULEN_GOOGLE_CLIENT_ID=
# FAMULEN_GOOGLE_CLIENT_SECRET=

# Famulen's Slack app, registered once (crates/gateway/services/slack/README.md). Every workspace
# you add on the console uses it.
# FAMULEN_SLACK_CLIENT_ID=
# FAMULEN_SLACK_CLIENT_SECRET=
# FAMULEN_SLACK_APP_TOKEN=xapp-...

# Optional. Host names the console answers to beside FAMULEN_CONSOLE_URL's,
# separated by commas.
# FAMULEN_CONSOLE_HOSTS=

# Optional. Host names the API answers to beside localhost and the address it
# listens at, separated by commas.
# FAMULEN_API_HOSTS=

# Optional. Where the gateway's HTTP receivers listen, and the URL they are
# reached at from outside, if you make them reachable (e.g. Tailscale
# Funnel). Google is then asked to tell calendar changes there. In a
# container, listen on 0.0.0.0 and publish the port in compose.yaml.
# FAMULEN_RECEIVE_LISTEN=127.0.0.1:7791
# FAMULEN_RECEIVE_URL=https://famulen.example.ts.net

# Optional. Where the notebook is kept, instead of in the data directory,
# until you move it on the console's 秘書 page. In
# a container, a path inside it: mount the directory there as well.
# FAMULEN_NOTEBOOK_DIR=~/notes/famulen

# Optional. Your time zone, for schedules and the time the secretary reads.
# Default: the machine's time zone (UTC in a container).
# FAMULEN_TIMEZONE=Asia/Tokyo

# Optional. Claude Code's model when none is assigned to the secretary on the
# console, and how much it thinks (low, medium, high, xhigh, max) when its
# assignment does not say.
# FAMULEN_CLAUDE_MODEL=sonnet
# FAMULEN_CLAUDE_EFFORT=medium
